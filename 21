 .container {
      width: 100%;
      max-width: 480px;
    }

    .card {
      background: rgba(255, 255, 255, 0.15);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.25);
      border-radius: 24px;
      padding: 2rem;
      color: #fff;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.2);
    }

    .location-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 1.5rem;
    }

    .location-name {
      font-size: 16px;
      font-weight: 600;
      opacity: 0.9;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .refresh-btn {
      background: rgba(255,255,255,0.2);
      border: 1px solid rgba(255,255,255,0.3);
      border-radius: 12px;
      color: #fff;
      font-size: 13px;
      padding: 6px 14px;
      cursor: pointer;
      transition: background 0.2s;
    }

    .refresh-btn:hover {
      background: rgba(255,255,255,0.3);
    }

    .main-weather {
      text-align: center;
      margin-bottom: 2rem;
    }

    .weather-icon {
      font-size: 72px;
      line-height: 1;
      margin-bottom: 0.5rem;
    }

    .temperature {
      font-size: 80px;
      font-weight: 300;
      line-height: 1;
      letter-spacing: -2px;
    }

    .feels-like {
      font-size: 14px;
      opacity: 0.8;
      margin-top: 6px;
    }

    .weather-desc {
      display: inline-block;
      margin-top: 10px;
      background: rgba(255,255,255,0.2);
      border-radius: 20px;
      padding: 4px 16px;
      font-size: 14px;
      font-weight: 500;
    }

    .detail-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
      margin-bottom: 1.5rem;
    }

    .detail-item {
      background: rgba(255, 255, 255, 0.12);
      border-radius: 16px;
      padding: 1rem;
      text-align: center;
    }

    .detail-label {
      font-size: 12px;
      opacity: 0.7;
      margin-bottom: 6px;
    }

    .detail-value {
      font-size: 20px;
      font-weight: 600;
    }

    .detail-icon {
      font-size: 22px;
      margin-bottom: 4px;
    }

    .section-title {
      font-size: 13px;
      opacity: 0.7;
      margin-bottom: 0.75rem;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .hourly-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 8px;
    }

    .hourly-item {
      background: rgba(255, 255, 255, 0.12);
      border-radius: 14px;
      padding: 0.6rem 0.4rem;
      text-align: center;
    }

    .hourly-time {
      font-size: 11px;
      opacity: 0.7;
      margin-bottom: 4px;
    }

    .hourly-icon {
      font-size: 20px;
      margin-bottom: 4px;
    }

    .hourly-temp {
      font-size: 14px;
      font-weight: 600;
    }

    .loader {
      text-align: center;
      padding: 3rem 0;
      opacity: 0.8;
      font-size: 15px;
    }

    .error {
      text-align: center;
      padding: 2rem 0;
      color: #ffcdd2;
      font-size: 14px;
    }

    .updated-time {
      text-align: center;
      font-size: 11px;
      opacity: 0.5;
      margin-top: 1rem;
    }
